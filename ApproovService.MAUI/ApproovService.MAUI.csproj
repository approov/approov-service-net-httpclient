<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <RootNamespace>Approov</RootNamespace>
    <AssemblyName>Approov.Service.Maui</AssemblyName>
    <Version>3.5.5</Version>
    <Authors>Approov Ltd</Authors>
    <Description>Approov service layer for .NET MAUI (Android + iOS)</Description>
    <!-- MIT is correct for this wrapper's own source. Packing is disabled because packing today
         would embed the proprietary ../libs/approov.aar (AndroidLibrary below) into an
         MIT-labelled package. Enable once the SDK arrives as a package reference
         (see approov/core-project-approov#714, #715). -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <PackageProjectUrl>https://approov.io</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Approov API-Protection Security Mobile MAUI Android iOS</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">18.0</TargetPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidLibrary Include="../libs/approov.aar" />
    <!-- The Approov Android SDK requires okhttp3 at runtime (see approov-service-okhttp build.gradle) -->
    <PackageReference Include="Square.OkHttp3" Version="4.12.0.10" />
    <!-- The SDK invokes Google Play Integrity directly; its Maven POM does not publish transitive dependencies. -->
    <!-- Newer bindings pull AndroidX Lifecycle 2.9/2.11 and cannot be restored
         alongside .NET MAUI 9's AndroidX Lifecycle 2.8 graph. Play Integrity 1.3
         provides the SDK runtime API while retaining the compatible AndroidX line. -->
    <PackageReference Include="Xamarin.Google.Android.Play.Integrity" Version="1.3.0.4" />
    <TransformFile Include="Transforms/Metadata.xml" />
    <Compile Remove="Platforms/iOS/**" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <ProjectReference Include="../iOS.Binding/iOS.Binding.csproj" />
    <Compile Remove="Platforms/Android/**" />
  </ItemGroup>
</Project>
